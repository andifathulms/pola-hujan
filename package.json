{
  "name": "pola-hujan",
  "version": "0.1.0",
  "private": true,
  "description": "Rainfall regime atlas for Indonesia — harmonic classification of the annual precipitation cycle into monsunal, ekuatorial and lokal families.",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm data:validate && next build",
    "preview": "next start",
    "test": "vitest",
    "test:run": "vitest run",
    "test:harmonic": "vitest run tests/harmonic",
    "test:classify": "vitest run tests/classify",
    "data:fetch": "tsx scripts/fetch-data.ts",
    "data:build": "tsx scripts/build-data.ts",
    "data:validate": "tsx scripts/validate-data.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.14.9",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.4",
    "tsx": "4.16.2",
    "typescript": "5.5.3",
    "vitest": "1.6.0"
  },
  "packageManager": "pnpm@9.15.9"
}
